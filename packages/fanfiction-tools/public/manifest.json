{
  "manifest_version": 3,
  "name": "FanFiction Tools",
  "version": "1.0",
  "description": "A simple Chrome extension for FanFiction.net",
  "permissions": ["activeTab"],
  "content_scripts": [
    {
      "matches": ["https://www.fanfiction.net/*"],
      "js": ["content.js"],
      "css": [""]
    }
  ]
}
